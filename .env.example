DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
AUTH_SECRET=""
# TMDB_API_KEY=""
# RESEND_API_KEY=""
# TIDAL_CLIENT_ID=""
# TIDAL_CLIENT_SECRET=""
# Kura iOS (fase 4e/4f) — una sola llave .p8 con APNs y Sign in with Apple.
# Sin ellas: push = no-op con log; el login con Apple funciona pero no se
# guarda el refresh token para revocar al borrar la cuenta.
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""   # contenido del .p8; acepta \n escapados
# AUTH_APPLE_DISABLED="" # "1" apaga Sign in with Apple (app y web)
# APPLE_WEB_CLIENT_ID=""  # Services ID de la web (p. ej. com.tromwey.kura.web); sin él no hay botón de Apple en /login
# GOOGLE_IOS_CLIENT_ID="" # sin él, auth/google = 503 y no se pinta el botón
# Invitación /party — los 16 caracteres después de /f/ del link ACTIVO de la
# fiesta (colección de fiesta) cuya playlist anuncia /party. Se expone a quien
# abra /party (decisión aceptada, state/security.md). Rotar = "Crear link
# nuevo" en la fiesta + cambiar esta var + desplegar. Sin ella: no hay tarjeta.
# PARTY_PLAYLIST_TOKEN=""

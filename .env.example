DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
AUTH_SECRET=""
# TMDB_API_KEY=""
# RESEND_API_KEY=""
# TIDAL_CLIENT_ID=""
# TIDAL_CLIENT_SECRET=""
# Kura iOS (fase 4e/4f) — una sola llave .p8 con APNs y Sign in with Apple.
# Sin ellas: push = no-op con log; el login con Apple funciona pero no se
# guarda el refresh token para revocar al borrar la cuenta.
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""   # contenido del .p8; acepta \n escapados
# AUTH_APPLE_DISABLED="" # "1" apaga Sign in with Apple (app y web)
# APPLE_WEB_CLIENT_ID=""  # Services ID de la web (p. ej. com.tromwey.kura.web); sin él no hay botón de Apple en /login
# GOOGLE_IOS_CLIENT_ID="" # sin él ni GOOGLE_WEB_CLIENT_ID, auth/google = 503 y no se pinta el botón
# GOOGLE_WEB_CLIENT_ID="" # client id "Aplicación web" del mismo proyecto GCP: aud de los idTokens de Android (Credential Manager); auth/providers lo expone como google.androidClientId
# FCM_SERVICE_ACCOUNT_JSON="" # JSON completo de la cuenta de servicio de Firebase (push Android por FCM HTTP v1); sensitive; sin él los envíos FCM se saltan con log
# Invitación /party — los 16 caracteres después de /f/ del link ACTIVO de la
# fiesta (colección de fiesta) cuya playlist anuncia /party. Se expone a quien
# abra /party (decisión aceptada, state/security.md). Rotar = "Crear link
# nuevo" en la fiesta + cambiar esta var + desplegar. Sin ella: no hay tarjeta.
# PARTY_PLAYLIST_TOKEN=""
# "Llévala a otra app" (exportar una fiesta; migración 0034 + MIGRATION_0034_LIVE).
# TIDAL usa la MISMA app de developer.tidal.com (TIDAL_CLIENT_ID/SECRET de arriba)
# + la URL de callback registrada EXACTA en el dashboard. Sin ella: "Próximamente".
# TIDAL_OAUTH_REDIRECT_URI="" # prod: https://get-kura.app/api/music/tidal/callback · local: http://localhost:3010/api/music/tidal/callback
# Apple Music: DOS papeles de llave. La llave dedicada (estas dos) es la ÚNICA que firma
# el developer token que va al navegador (MusicKit JS, 1 h, con `origin`); sin ella la web
# dice "Próximamente" en Apple Music (iOS sigue). Para lo que el servidor le pide a Apple
# (ISRC, sonda) sirve la dedicada o, si falta, la compartida APPLE_KEY_ID/APPLE_PRIVATE_KEY
# (con MusicKit habilitado); ese token nunca sale del servidor.
# APPLE_MUSIC_KEY_ID=""
# APPLE_MUSIC_PRIVATE_KEY=""  # contenido del .p8; acepta \n escapados
# Cifrado de los tokens de TIDAL en la DB (AES-256-GCM). RECOMENDADA en producción
# (32+ bytes aleatorios, p. ej. `openssl rand -base64 48`): sin ella se deriva de AUTH_SECRET,
# y rotar AUTH_SECRET desconectaría TIDAL a todos. Cambiarla invalida los tokens guardados.
# MUSIC_TOKEN_KEY=""
